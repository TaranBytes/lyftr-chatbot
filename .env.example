# Copy to .env and fill in. NEVER commit .env or real keys.

# --- Backend ---------------------------------------------------------------
# Comma-separated API key pool (at least 2). Ids are assigned in order: key_1, key_2, ...
LLM_API_KEYS=your-first-gemini-key,your-second-gemini-key
# LiteLLM model name used for every key.
LLM_MODEL=gemini/gemini-3.5-flash-lite
# SQLite file. Inside Docker this lives on the named volume mounted at /data.
DATABASE_URL=sqlite:////data/app.db
# Comma-separated browser origins allowed by CORS (no trailing slash).
ALLOWED_ORIGINS=http://localhost:3000
# "true" enables the X-Simulate-Failure test header (must be true on the deployed backend for the demo).
ENABLE_FAILURE_SIMULATION=true

# --- Optional backend settings ----------------------------------------------
# LLM_TIMEOUT_SECONDS=30
# DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.

# --- Frontend (build-time) ---------------------------------------------------
# URL of the backend as seen from the user's browser.
VITE_API_URL=http://localhost:8000
